# Most env vars have sane defaults baked into docker-compose.yml.  This
# file is for the handful you'll actually want to override per machine.
# Copy to `.env`, edit, then `docker compose up`.

# Port the orchestrator binds on the HOST (network_mode: host).
# Frontend is served from http://localhost:${HOST_PORT}.
HOST_PORT=8080

# Shared secret protecting the desktop-agent's HTTP endpoints.  Auto-
# generated on first run by desktop-agent; copy the value from
# ~/.cache/voice-assistant/desktop-token after starting the agent for
# the first time.  Leave empty here to rely on the auto-generated one.
DESKTOP_TOKEN=

# Multi-agent mode (optional).  JSON list of remote desktop-agents to
# route to.  See docker-compose.yml for shape; leave empty for the
# default single-agent localhost setup.
DESKTOP_AGENTS=

# ── Desktop-agent knobs (host-side process; read by desktop-agent.py) ──
# These are consumed by the desktop-agent, not the orchestrator.  Defaults
# are fine for the standard single-machine setup; override per host.

# Global dictation hotkey (#41).  Combo that triggers push-to-talk from
# any app.  pynput combo syntax; default is Ctrl+Shift+Space.
HOTKEY_COMBO=<ctrl>+<shift>+space

# Set to 0 to disable the global hotkey listener entirely.
HOTKEY_ENABLED=1

# Where the hotkey webhook POSTs the PTT trigger.  MUST point at the
# orchestrator — if you change HOST_PORT above, change this port to match.
ORCHESTRATOR_WEBHOOK_URL=http://localhost:8080

# Chrome DevTools Protocol port for the browser-control tools (#51) and
# tab streaming (#53).  Must match the --remote-debugging-port Chrome was
# launched with.  Default 9222.
CHROME_DEBUG_PORT=9222
