# Most env vars have sane defaults baked into docker-compose.yml.  This
# file is for the handful you'll actually want to override per machine.
# Copy to `.env`, edit, then `docker compose up`.

# Port the orchestrator binds on the HOST (network_mode: host).
# Frontend is served from http://localhost:${HOST_PORT}.
HOST_PORT=8080

# Shared secret protecting the desktop-agent's HTTP endpoints.  Auto-
# generated on first run by desktop-agent; copy the value from
# ~/.cache/voice-assistant/desktop-token after starting the agent for
# the first time.  Leave empty here to rely on the auto-generated one.
DESKTOP_TOKEN=

# Multi-agent mode (optional).  JSON list of remote desktop-agents to
# route to.  See docker-compose.yml for shape; leave empty for the
# default single-agent localhost setup.
DESKTOP_AGENTS=
