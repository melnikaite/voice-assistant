# Local data (SQLite DB, VAPID key, custom voices, TTS model cache)
data/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
# orchestrator/uv.lock is generated by `pip install -e ".[test]"` for
# local dev — runtime deps live in the Dockerfile, so we don't pin
# this lock.  (desktop-agent/uv.lock and xtts-server/uv.lock are
# tracked because those services use uv for runtime deps.)
orchestrator/uv.lock

# Secrets — belt and braces over data/ in case anyone moves them
.env
.env.local
*.pem
*.key
*.p12
*.pfx

# SQLite (covers anything outside data/)
*.db
*.db-shm
*.db-wal

# Editor / IDE
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.claude/

# Logs
*.log
